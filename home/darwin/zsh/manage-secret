#!/usr/bin/env zsh

set -euo pipefail

secrets_file="$HOME/.secrets"

delete_secret() {
  print -n "Environment variable name: "
  read env_var
  [[ -z "$env_var" ]] && { print "Name is required."; exit 1 }

  keychain_name="${(L)env_var//_/-}"

  security delete-generic-password -a "$USER" -s "$keychain_name" 2>/dev/null || true
  sed -i '' "/^${env_var}=/d" "$secrets_file"

  print "Removed ${env_var} from Keychain and ~/.secrets"
}

add_secret() {
  print -n "Environment variable name: "
  read env_var

  print -n "Secret value: "
  read -s secret_value
  print

  [[ -z "$env_var" || -z "$secret_value" ]] && { print "All fields are required."; exit 1 }

  keychain_name="${(L)env_var//_/-}"

  # Store in macOS Keychain (update if it already exists)
  security delete-generic-password -a "$USER" -s "$keychain_name" 2>/dev/null || true
  security add-generic-password -a "$USER" -s "$keychain_name" -w "$secret_value"

  # Add or update mapping in ~/.secrets
  if grep -q "^${env_var}=" "$secrets_file" 2>/dev/null; then
    sed -i '' "s|^${env_var}=.*|${env_var}=${keychain_name}|" "$secrets_file"
    print "Updated ${env_var} -> ${keychain_name} in ~/.secrets"
  else
    print "${env_var}=${keychain_name}" >> "$secrets_file"
    print "Added ${env_var} -> ${keychain_name} to ~/.secrets"
  fi

  print "Secret stored in Keychain. Run 'source ~/.secrets.zsh' or open a new shell to activate."
}

print "Manage secrets in macOS Keychain and ~/.secrets"
print
print "1) Add/update a secret"
print "2) Delete a secret"
print
print -n "Choice [1]: "
read choice

case "${choice:-1}" in
  1) add_secret ;;
  2) delete_secret ;;
  *) print "Invalid choice."; exit 1 ;;
esac
