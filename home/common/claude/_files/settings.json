{
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": true,
    "network": {
      "allowUnixSockets": ["~/.rd/docker.sock"],
      "allowLocalBinding": true
    },
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.gnupg",
        "~/.netrc",
        "**/.env",
        "**/.env.*",
        "**/*.pem",
        "**/*.key",
        "**/*.p12",
        "**/*.pfx",
        "**/*.jks",
        "**/*.keystore",
        "**/id_rsa",
        "**/id_dsa",
        "**/id_ecdsa",
        "**/id_ed25519",
        "**/credentials",
        "**/.credentials",
        "**/.npmrc",
        "**/.pypirc"
      ]
    }
  },
  "skipDangerousModePermissionPrompt": true,
  "enableAllProjectMcpServers": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|NotebookEdit|WebFetch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "cerberus guard"
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "pharos tmux dispatch tool"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "pharos tmux dispatch ask"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "pharos tmux dispatch think"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pharos tmux dispatch think"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pharos tmux dispatch off"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pharos tmux dispatch notify"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cerberus health"
          },
          {
            "type": "command",
            "command": "psyche --format claude ~/.claude/plugins/marketplaces/local/plugins/custom/SOUL.md"
          },
          {
            "type": "command",
            "command": "pharos tmux dispatch off"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pharos tmux dispatch off"
          }
        ]
      }
    ]
  },
  "disableAllHooks": false,
  "statusLine": {
    "type": "command",
    "command": "pharos render",
    "refreshInterval": 30
  },
  "enabledPlugins": {
    "custom@local": true,
    "gopls-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "press@press": true,
    "swift-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "press": {
      "source": {
        "source": "github",
        "repo": "ahokinson/press"
      }
    }
  },
  "tui": "fullscreen",
  "theme": "dark-ansi",
  "editorMode": "normal",
  "autoCompactEnabled": false,
  "showTurnDuration": false,
  "useAutoModeDuringPlan": false
}
