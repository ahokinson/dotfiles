{
  "plugins": ["~/.config/pharos/guards.ts"],
  "palette": {
    "rosewater": "#f5e0dc",
    "flamingo": "#f2cdcd",
    "pink": "#f5c2e7",
    "mauve": "#cba6f7",
    "red": "#f38ba8",
    "maroon": "#eba0ac",
    "peach": "#fab387",
    "yellow": "#f9e2af",
    "green": "#a6e3a1",
    "teal": "#94e2d5",
    "sky": "#89dceb",
    "sapphire": "#74c7ec",
    "blue": "#89b4fa",
    "lavender": "#b4befe",
    "text": "#cdd6f4",
    "subtext1": "#bac2de",
    "subtext0": "#a6adc8",
    "overlay2": "#9399b2",
    "overlay1": "#7f849c",
    "overlay0": "#6c7086",
    "surface2": "#585b70",
    "surface1": "#45475a",
    "surface0": "#313244",
    "base": "#1e1e2e",
    "mantle": "#181825",
    "crust": "#11111b"
  },
  "metricStyle": {
    "tools": { "hideZero": true }
  },
  "fieldOrder": [
    "diff",
    "tools",
    "toolErrors",
    "cost",
    "tokens",
    "context",
    "guards",
    "model",
    "rate"
  ],
  "templates": {
    "sidecard": {
      "format": "ansi",
      "renderer": "opentui",
      "lines": [
        "{{#harness}}{{{harness}}}{{#profile}} · {{{profile}}}{{/profile}}{{/harness}}",
        "5h limit\t{{#rate5}}{{{rate5}}}{{/rate5}}{{^rate5}}—{{/rate5}}",
        "7d limit\t{{#rate7}}{{{rate7}}}{{/rate7}}{{^rate7}}—{{/rate7}}",
        "",
        "Approval\t{{#approval}}{{{approval}}}{{/approval}}{{^approval}}—{{/approval}}",
        "Sandbox\t{{#sandbox}}{{{sandbox}}}{{/sandbox}}{{^sandbox}}—{{/sandbox}}",
        "Guards\t{{#guards}}{{{guards}}}{{/guards}}{{^guards}}—{{/guards}}",
        "",
        "Model\t{{#modelName}}{{{modelName}}}{{/modelName}}{{#ctxWindow}} · {{{ctxWindow}}}{{/ctxWindow}}",
        "Thinking\t{{#agent}}{{{agent}}}{{/agent}}{{^agent}}—{{/agent}}",
        "",
        "Remote\t{{#origin}}{{{origin}}}{{/origin}}{{^origin}}—{{/origin}}",
        "Branch\t{{#branch}}{{{branch}}}{{/branch}}{{^branch}}—{{/branch}}",
        "Tree\t{{#worktree}}{{{worktree}}}{{/worktree}}{{^worktree}}—{{/worktree}}",
        "Changes\t{{#worktreeDiff}}{{{worktreeDiff}}}{{/worktreeDiff}}{{^worktreeDiff}}—{{/worktreeDiff}}",
        "",
        "Context\t{{#contextCard}}{{{contextCard}}}{{/contextCard}}",
        "Tokens\t{{#tokens}}{{{tokens}}}{{/tokens}}{{^tokens}}—{{/tokens}}",
        "Tools\t{{#tools}}{{{tools}}}{{/tools}}{{^tools}}—{{/tools}}",
        "Errors\t{{#toolErrors}}{{{toolErrors}}}{{/toolErrors}}{{^toolErrors}}—{{/toolErrors}}",
        "Diff\t{{#diff}}{{{diff}}}{{/diff}}{{^diff}}—{{/diff}}",
        "Cost\t{{#cost}}{{{cost}}}{{/cost}}{{^cost}}—{{/cost}}"
      ]
    }
  }
}
