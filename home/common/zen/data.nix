# Zen browser preferences applied identically on every machine, sourced from
# zen-browser/desktop's shipped prefs/zen/*.yaml with a handful of overrides.
{ pkgs, selfPath, ... }:
let
  sharedFonts = import (selfPath "home/common/fonts.nix") { inherit pkgs; };
in
{
  "browser.contentblocking.category" = "standard";
  "browser.urlbar.shortcuts.workspaces" = true;
  "dom.security.https_only_mode" = true;
  "extensions.formautofill.addresses.enabled" = false;
  "extensions.formautofill.creditCards.enabled" = false;
  # Default/fallback fonts only - browser.display.use_document_fonts stays
  # at its default (1), so pages that specify their own fonts are unaffected.
  # Matches the family strings ghostty and COSMIC already use (fonts.nix).
  "font.name.monospace.x-western" = sharedFonts.monoFamily;
  "font.name.sans-serif.x-western" = sharedFonts.generalFamily;
  "font.name.serif.x-western" = sharedFonts.generalFamily;
  "image.avif.enabled" = true;
  "image.jxl.enabled" = true;
  "media.eme.enabled" = true;
  "signon.rememberSignons" = false;
  "svg.context-properties.content.enabled" = true;
  "widget.macos.native-popovers" = true;
  "widget.macos.sidebar-blend-mode.behind-window" = false;
  "zen.boosts.disable-on-anonymous-content" = true;
  "zen.boosts.dissolve-on-zap" = true;
  "zen.boosts.enabled" = true;
  "zen.boosts.invert-channel-floor" = 15;
  "zen.ctrlTab.show-pending-tabs" = false;
  "zen.downloads.download-animation" = true;
  "zen.downloads.download-animation-duration" = 1000;
  "zen.downloads.icon-popup-position" = 0;
  "zen.folders.max-subfolders" = 5;
  "zen.folders.owned-tabs-in-folder" = false;
  "zen.folders.search.enabled" = true;
  "zen.folders.search.hover-delay" = 500;
  "zen.glance.activation-method" = "alt";
  "zen.glance.animation-duration" = 350;
  "zen.glance.deactivate-docshell-during-animation" = false;
  "zen.glance.enable-contextmenu-search" = true;
  "zen.glance.enabled" = false;
  "zen.glance.open-essential-external-links" = true;
  "zen.haptic-feedback.enabled" = true;
  "zen.live-folders.github.skip-new-pr-ui-check" = false;
  "zen.mediacontrols.enabled" = true;
  "zen.pinned-tab-manager.close-shortcut-behavior" = "reset-unload-switch";
  "zen.pinned-tab-manager.restore-pinned-tabs-to-pinned-url" = false;
  "zen.pinned-tab-manager.wheel-close-if-pending" = true;
  "zen.share.enabled" = true;
  "zen.splitView.drag-over-split-delayMC" = 500;
  "zen.splitView.drag-over-split-threshold" = 40;
  "zen.splitView.enable-drag-over-split" = true;
  "zen.splitView.enable-tab-click-split" = true;
  "zen.splitView.enable-tab-drop" = true;
  "zen.splitView.min-resize-width" = 7;
  "zen.splitView.rearrange-hover-size" = 24;
  "zen.startup.smooth-scroll-in-tabs" = true;
  "zen.tabs.close-on-back-with-no-history" = true;
  "zen.tabs.close-window-with-empty" = true;
  "zen.tabs.ctrl-tab.ignore-essential-tabs" = false;
  "zen.tabs.ctrl-tab.ignore-pending-tabs" = false;
  "zen.tabs.dnd-switch-space-delay" = 500;
  "zen.tabs.essentials.max" = 12;
  "zen.tabs.folder-dragover-threshold-percent" = 20;
  "zen.tabs.open-pinned-in-new-tab" = true;
  "zen.tabs.rename-tabs" = true;
  "zen.tabs.select-recently-used-on-close" = true;
  "zen.tabs.show-newtab-vertical" = true;
  "zen.tabs.vertical" = true;
  "zen.tabs.vertical.right-side" = true;
  "zen.theme.accent-color" = "AccentColor";
  "zen.theme.border-radius" = -1;
  "zen.theme.content-element-separation" = 8;
  "zen.theme.dark-mode-bias" = 0.3;
  "zen.theme.disable-lightweight" = true;
  "zen.theme.essentials-favicon-bg" = true;
  "zen.theme.gradient.show-custom-colors" = false;
  "zen.theme.hide-tab-throbber" = true;
  "zen.theme.hide-unified-extensions-button" = true;
  "zen.theme.styled-status-panel" = true;
  "zen.theme.use-system-colors" = false;
  "zen.urlbar.behavior" = "floating-on-type";
  "zen.urlbar.enable-overrides" = false;
  "zen.urlbar.hide-one-offs" = true;
  "zen.urlbar.open-on-startup" = true;
  "zen.urlbar.replace-newtab" = true;
  "zen.urlbar.show-contextual-id" = false;
  "zen.urlbar.show-domain-only-in-sidebar" = true;
  "zen.urlbar.show-pip-button" = false;
  "zen.urlbar.show-protections-icon" = true;
  "zen.urlbar.single-toolbar-show-copy-url" = true;
  "zen.urlbar.suggestions.quick-actions" = true;
  "zen.urlbar.wait-to-clear" = 45000;
  "zen.view.borderless-fullscreen" = true;
  "zen.view.compact.animate-sidebar" = true;
  "zen.view.compact.enable-at-startup" = true;
  "zen.view.compact.hide-tabbar" = true;
  "zen.view.compact.hide-toolbar" = false;
  "zen.view.compact.show-background-tab-toast" = true;
  "zen.view.compact.show-sidebar-and-toolbar-on-hover" = true;
  "zen.view.compact.sidebar-keep-hover.duration" = 150;
  "zen.view.compact.toolbar-flash-popup" = false;
  "zen.view.compact.toolbar-flash-popup.duration" = 800;
  "zen.view.compact.toolbar-hide-after-hover.duration" = 1000;
  "zen.view.enable-loading-indicator" = true;
  "zen.view.experimental-force-window-controls-left" = false;
  "zen.view.experimental-no-window-controls" = false;
  "zen.view.grey-out-inactive-windows" = false;
  "zen.view.hide-window-controls" = true;
  "zen.view.mac.show-three-dot-menu" = false;
  "zen.view.overflow-webext-toolbar" = true;
  "zen.view.overflow-webext-toolbar-threshold" = 55;
  "zen.view.shift-down-site-on-hover" = false;
  "zen.view.show-clear-tabs-button" = true;
  "zen.view.show-newtab-button-top" = true;
  "zen.view.sidebar-expanded" = true;
  "zen.view.sidebar-expanded.max-width" = 500;
  "zen.view.sidebar-height-throttle" = 0;
  "zen.view.use-single-toolbar" = true;
  "zen.welcome-screen.seen" = true;
  "zen.widget.mac.mono-window-controls" = true;
  "zen.widget.macos.override-system-swipe-gestures" = true;
  "zen.widget.macos.window-material" = 7;
  "zen.window-sync.enabled" = true;
  "zen.window-sync.open-link-in-new-unsynced-window" = true;
  "zen.window-sync.prefer-unsynced-windows" = false;
  "zen.window-sync.sync-only-pinned-tabs" = true;
  "zen.workspaces.continue-where-left-off" = false;
  "zen.workspaces.dnd-switch-padding" = 20;
  "zen.workspaces.force-container-workspace" = false;
  "zen.workspaces.hide-default-container-indicator" = true;
  "zen.workspaces.natural-scroll" = false;
  "zen.workspaces.open-new-tab-if-last-unpinned-tab-is-closed" = false;
  "zen.workspaces.scroll-modifier-key" = "ctrl";
  "zen.workspaces.separate-essentials" = true;
  "zen.workspaces.swipe-actions" = true;
  "zen.workspaces.swipe-actions.delta-multiplier" = 100;
  "zen.workspaces.switch-animation-duration" = 200;
  "zen.workspaces.wrap-around-navigation" = true;
  # Theme-required prefs (normally auto-added by the catppuccin preset
  # module, added manually here since we bypass that module entirely).
  "toolkit.legacyUserProfileCustomizations.stylesheets" = true;
  "ui.systemUsesDarkTheme" = 1;
  "zen.view.window.scheme" = 0;
}
