# This directory is symlinked to cupcake's global store (~/Library/Application
# Support/cupcake) by cupcake/dot.zsh. Everything here is generated by
# `cupcake init --global` EXCEPT our custom policies under
# policies/<harness>/custom/ — those are the only version-controlled files.
/*
!/.gitignore
!/policies/
/policies/*
!/policies/claude/
/policies/claude/*
!/policies/claude/custom/
!/policies/opencode/
/policies/opencode/*
!/policies/opencode/custom/
